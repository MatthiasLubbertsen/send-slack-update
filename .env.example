# Slack token used to post. Required. Found under
# https://api.slack.com/apps -> your app -> "OAuth & Permissions".
#   xoxb-...  Bot User OAuth Token: posts as the app (needs bot scope chat:write)
#   xoxp-...  User OAuth Token: posts as you (needs user scope chat:write)
SLACK_BOT_TOKEN=xoxb-...

# Channel ID to post to (e.g. C0123456789), not the channel name.
# Open the channel -> click its name -> the ID is at the bottom of "About". Required.
SLACK_CHANNEL_ID=C0123456789

# ID of the user group pinged in the daily update (starts with S). Required.
SLACK_USERGROUP_ID=S0AK8LYJ8FR

# App-Level Token (xapp-...). No longer used: the app only calls the Web API,
# so Socket Mode isn't needed. Safe to leave in your .env.
SLACK_APP_TOKEN=xapp-...

# Port the server listens on when running without Docker. Optional, default 3000.
# PORT=3000
